---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import "./_home/home.css";
import "./_home/desk.css";

const { config } = data;
const description =
  config.description ??
  "Personal writing and projects from Poornima Jagannath on developer experience, APIs, SDKs, AI agents, and small things built outside work.";
---

<PageLayout
  site={{ title: config.title, description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: config.title,
    description,
    route: "/",
  }}
>
  <link rel="stylesheet" href="/assets/frost-p.css?v=12" />
  <div class="home">
    <section class="desk" data-desk data-desk-view="desk" id="desk" aria-labelledby="desk-title">
      <div class="desk__intro">
        <h1 id="desk-title">Poornima Jagannath</h1>
        <p>
          I care about developer experience, APIs, SDKs, and AI a little more
          than I probably need to. This desk has two computers: the job, and
          everything I make after hours.
        </p>
      </div>

      <div class="desk__room">
        <div class="desk__window" aria-hidden="true"></div>
        <div class="desk__table">
          <div class="desk__surface">
            <div class="desk__machines">
            <article class="machine machine--work" id="work">
              <p class="machine__name">Work</p>
              <div class="machine__chassis">
                <div class="machine__lid">
                  <div class="machine__bezel">
                    <span class="machine__camera" aria-hidden="true"></span>
                    <a class="machine__enter" href="#work" data-desk-enter="work">
                      <span>Open the work computer</span>
                    </a>
                    <button class="machine__back" type="button" data-desk-leave>
                      Back to the desk
                    </button>
                    <div class="machine__screen">
                      <div class="machine__idle" aria-hidden="true">
                        <strong>Developer experience in payments</strong>
                        <span>APIs, SDKs, and the first working call</span>
                      </div>
                      <div class="machine__inside">
                        <h2>The work computer</h2>
                        <p>
                          I lead product work and manage people. Most of my work
                          sits at the point where developers meet a payments
                          platform.
                        </p>
                        <ul class="machine__list">
                          <li>
                            <span class="machine__list-title">APIs and SDKs</span>
                            <span class="machine__list-body"
                              >The paths developers use to understand an API,
                              pick an SDK, set up a sandbox, and make a first
                              call.</span
                            >
                          </li>
                          <li>
                            <span class="machine__list-title">Time to integrate</span>
                            <span class="machine__list-body"
                              >Shrinking the time between a first question and a
                              successful integration.</span
                            >
                          </li>
                          <li>
                            <a
                              href="https://www.youtube.com/playlist?list=PL9qINLsWlhs2fzbdsdEBTMNgasNhbG4er"
                              target="_blank"
                              rel="noopener"
                            >
                              <span class="machine__list-title"
                                >Cybersource Developer Education Series</span
                              >
                              <span class="machine__list-body"
                                >A public video series on payments and the
                                developer center.</span
                              >
                            </a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="machine__deck" aria-hidden="true">
                  <div class="machine__trackpad"></div>
                </div>
              </div>
            </article>

            <div class="desk__mascot soft-hero__mark-stage" aria-hidden="true">
              <span class="soft-hero__floor-shadow"></span>
              <canvas data-frost-p width="240" height="260"></canvas>
            </div>

            <article class="machine machine--personal" id="personal">
              <p class="machine__name">Personal</p>
              <div class="machine__chassis">
                <div class="machine__lid">
                  <div class="machine__bezel">
                    <span class="machine__camera" aria-hidden="true"></span>
                    <a class="machine__enter" href="#personal" data-desk-enter="personal">
                      <span>Open the personal computer</span>
                    </a>
                    <button class="machine__back" type="button" data-desk-leave>
                      Back to the desk
                    </button>
                    <div class="machine__screen">
                      <div class="machine__idle" aria-hidden="true">
                        <strong>Essays, a Kannada app, hello</strong>
                        <span>Writing, building, and how to reach me</span>
                      </div>
                      <div class="machine__inside">
                        <h2>The personal computer</h2>
                        <p>
                          Essays, a small iOS app for my daughter, and the
                          places I am easy to find.
                        </p>
                        <ul class="machine__list">
                          <li>
                            <a href="/writing/building-this-site-in-the-ai-era">
                              <span class="machine__list-title"
                                >How this site came together</span
                              >
                              <span class="machine__list-body"
                                >Voice notes, Codex, Markdown, Astro, Blume, and
                                a lot of editing.</span
                              >
                            </a>
                          </li>
                          <li>
                            <a href="/writing/buying-back-time-with-ai-agents">
                              <span class="machine__list-title"
                                >Buying back time with AI agents</span
                              >
                              <span class="machine__list-body"
                                >What a small Slack fleet is teaching me about
                                time and presence.</span
                              >
                            </a>
                          </li>
                          <li>
                            <a href="/building/whats-this-in-kannada">
                              <span class="machine__list-title"
                                >What&apos;s This in Kannada?</span
                              >
                              <span class="machine__list-body"
                                >A love letter written in code. A small iOS app
                                for my daughter.</span
                              >
                            </a>
                          </li>
                          <li>
                            <a href="/connect">
                              <span class="machine__list-title">Say hello</span>
                              <span class="machine__list-body"
                                >LinkedIn, and the rest of this site.</span
                              >
                            </a>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="machine__deck" aria-hidden="true">
                  <div class="machine__trackpad"></div>
                </div>
              </div>
            </article>
            </div>

            <div class="desk__prop desk__prop--cup" aria-hidden="true"></div>
            <div class="desk__prop desk__prop--notebook" aria-hidden="true"></div>
            <div class="desk__top" aria-hidden="true"></div>
          </div>
        </div>
      </div>
      <p class="desk__hint">Click a screen to sit down at that computer.</p>
    </section>

    <script is:inline type="module">
      const bindDesk = () => {
        const root = document.querySelector(`[data-desk]`);
        if (!root || root.dataset.homeBound === `1`) return;
        root.dataset.homeBound = `1`;

        const hint = root.querySelector(`.desk__hint`);
        const fallback = () =>
          window.matchMedia(`(max-width: 860px), (prefers-reduced-motion: reduce)`)
            .matches;

        const setView = (view, { hash = true } = {}) => {
          const next = view === `work` || view === `personal` ? view : `desk`;
          root.dataset.deskView = next;
          if (hint) hint.hidden = next !== `desk`;
          if (!hash) return;
          const url = new URL(location.href);
          if (next === `desk`) url.hash = ``;
          else url.hash = next;
          history.replaceState(null, ``, url);
        };

        const fromHash = () => {
          const id = location.hash.replace(`#`, ``);
          if (id === `work` || id === `personal`) setView(id, { hash: false });
          else setView(`desk`, { hash: false });
        };

        root.querySelectorAll(`[data-desk-enter]`).forEach((el) => {
          el.addEventListener(`click`, (e) => {
            if (fallback()) return;
            e.preventDefault();
            const view = el.getAttribute(`data-desk-enter`);
            setView(view);
            const back = root.querySelector(
              `.machine--${view} [data-desk-leave]`,
            );
            back?.focus();
          });
        });

        root.querySelectorAll(`[data-desk-leave]`).forEach((el) => {
          el.addEventListener(`click`, () => {
            const side = root.dataset.deskView;
            setView(`desk`);
            const enter = root.querySelector(
              `.machine--${side} [data-desk-enter]`,
            );
            enter?.focus();
          });
        });

        addEventListener(`hashchange`, fromHash);
        fromHash();
      };
      bindDesk();
      document.addEventListener(`astro:page-load`, bindDesk);
    </script>
    <script is:inline type="module" src="/assets/frost-p.js?v=12"></script>

    <section
      class="home-section home-section--bookshelf"
      data-reveal
      id="bookshelf"
      aria-labelledby="bookshelf-title"
    >
      <div class="home-rail">
        <header class="home-section__head">
          <h2 id="bookshelf-title">Books I keep returning to</h2>
          <p>
            A few books that shaped how I think about products, teams, systems,
            and work.
          </p>
        </header>
        <div class="bookshelf is-ready" data-bookshelf>
          <div class="bookshelf__stage">
            <button
              class="bookshelf__nav bookshelf__nav--prev"
              type="button"
              aria-label="Previous books"
              data-bookshelf-prev
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M15 18l-6-6 6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <div
              class="bookshelf__track"
              data-bookshelf-track
              tabindex="0"
              role="list"
              aria-label="Books on the shelf"
            >
              <article
                class="bookshelf__book bookshelf__book--blue"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="0"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title"
                    >The Design of Everyday Things</span
                  >
                  <span class="bookshelf__cover-author">Don Norman</span>
                </div>
                <h3 class="visually-hidden">
                  The Design of Everyday Things by Don Norman. Made me care about
                  affordances before I had the word for it.
                </h3>
              </article>
              <article
                class="bookshelf__book bookshelf__book--blush"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="1"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title">Inspired</span>
                  <span class="bookshelf__cover-author">Marty Cagan</span>
                </div>
                <h3 class="visually-hidden">
                  Inspired by Marty Cagan. Still the book I hand people when
                  “product” starts meaning too many things at once.
                </h3>
              </article>
              <article
                class="bookshelf__book bookshelf__book--cream"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="2"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title">Working Backwards</span
                  >
                  <span class="bookshelf__cover-author">Bryar &amp; Carr</span>
                </div>
                <h3 class="visually-hidden">
                  Working Backwards by Bryar &amp; Carr. Still the cleanest way I
                  know to force product clarity.
                </h3>
              </article>
              <article
                class="bookshelf__book bookshelf__book--lilac"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="3"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title"
                    >The Making of a Manager</span
                  >
                  <span class="bookshelf__cover-author">Julie Zhuo</span>
                </div>
                <h3 class="visually-hidden">
                  The Making of a Manager by Julie Zhuo. Honest about the awkward
                  middle of learning to lead without losing the work.
                </h3>
              </article>
              <article
                class="bookshelf__book bookshelf__book--ink"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="4"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title">The Manager's Path</span>
                  <span class="bookshelf__cover-author">Camille Fournier</span>
                </div>
                <h3 class="visually-hidden">
                  The Manager's Path by Camille Fournier. Useful when people
                  management stopped being theoretical.
                </h3>
              </article>
              <article
                class="bookshelf__book bookshelf__book--blush"
                role="listitem"
                tabindex="0"
                style="--book-h:172px"
                data-book-index="5"
              >
                <div class="bookshelf__cover" aria-hidden="true">
                  <span class="bookshelf__cover-title">Thinking in Systems</span>
                  <span class="bookshelf__cover-author">Donella Meadows</span>
                </div>
                <h3 class="visually-hidden">
                  Thinking in Systems by Donella Meadows. Changed how I see
                  platforms, incentives, and the loops developers get stuck in.
                </h3>
              </article>
            </div>
            <div class="bookshelf__shelf" aria-hidden="true">
              <span class="bookshelf__shelf-top"></span>
              <span class="bookshelf__shelf-face"></span>
            </div>
            <button
              class="bookshelf__nav bookshelf__nav--next"
              type="button"
              aria-label="Next books"
              data-bookshelf-next
            >
              <svg
                aria-hidden="true"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M9 18l6-6-6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>
        </div>
        <ul class="bookshelf-notes" data-bookshelf-notes>
          <li class="bookshelf-notes__item" data-book-note="0">
            <span class="bookshelf-notes__title"
              >The Design of Everyday Things</span
            >
            <span class="bookshelf-notes__body"
              >Made me care about affordances before I had the word for it.</span
            >
          </li>
          <li class="bookshelf-notes__item" data-book-note="1">
            <span class="bookshelf-notes__title">Inspired</span>
            <span class="bookshelf-notes__body"
              >Still the book I hand people when “product” starts meaning too
              many things at once.</span
            >
          </li>
          <li class="bookshelf-notes__item" data-book-note="2">
            <span class="bookshelf-notes__title">Working Backwards</span>
            <span class="bookshelf-notes__body"
              >Still the cleanest way I know to force product clarity.</span
            >
          </li>
          <li class="bookshelf-notes__item" data-book-note="3">
            <span class="bookshelf-notes__title">The Making of a Manager</span>
            <span class="bookshelf-notes__body"
              >Honest about the awkward middle of learning to lead without losing
              the work.</span
            >
          </li>
          <li class="bookshelf-notes__item" data-book-note="4">
            <span class="bookshelf-notes__title">The Manager's Path</span>
            <span class="bookshelf-notes__body"
              >Useful when people management stopped being theoretical.</span
            >
          </li>
          <li class="bookshelf-notes__item" data-book-note="5">
            <span class="bookshelf-notes__title">Thinking in Systems</span>
            <span class="bookshelf-notes__body"
              >Changed how I see platforms, incentives, and the loops developers
              get stuck in.</span
            >
          </li>
        </ul>
      </div>
    </section>

    <script is:inline type="module">
      const bindBookshelf = () => document.querySelectorAll(`[data-bookshelf]`).forEach((root) => {
        if (root.dataset.homeBound === `1`) return;
        root.dataset.homeBound = `1`;
        const track = root.querySelector(`[data-bookshelf-track]`);
        const prev = root.querySelector(`[data-bookshelf-prev]`);
        const next = root.querySelector(`[data-bookshelf-next]`);
        const notes = root.parentElement?.querySelector(`[data-bookshelf-notes]`);
        if (!track || !prev || !next) return;
        root.classList.add(`is-ready`);
        const reduce = () =>
          window.matchMedia(`(prefers-reduced-motion: reduce)`).matches;
        const setActiveNote = (index) => {
          if (!notes) return;
          notes.querySelectorAll(`[data-book-note]`).forEach((el) => {
            const on = el.getAttribute(`data-book-note`) === String(index);
            el.classList.toggle(`is-active`, on);
          });
          notes.classList.toggle(`has-active`, index != null);
        };
        const timers = new WeakMap();
        let tap = null;
        const popBook = (book) => {
          if (!book) return;
          const index = book.getAttribute(`data-book-index`);
          setActiveNote(index);
          if (reduce()) return;
          const prevTimer = timers.get(book);
          if (prevTimer) clearTimeout(prevTimer);
          book.classList.remove(`is-popping`, `is-settling`);
          void book.offsetWidth;
          book.classList.add(`is-popping`);
          const t = setTimeout(() => {
            book.classList.add(`is-settling`);
            book.classList.remove(`is-popping`);
            const t2 = setTimeout(
              () => book.classList.remove(`is-settling`),
              160,
            );
            timers.set(book, t2);
          }, 220);
          timers.set(book, t);
        };
        track.addEventListener(
          `pointerdown`,
          (e) => {
            const book = e.target.closest(`.bookshelf__book`);
            if (!book || !track.contains(book)) return;
            if (e.pointerType === `mouse` && e.button !== 0) return;
            tap = { id: e.pointerId, x: e.clientX, y: e.clientY, book };
          },
          { passive: true },
        );
        track.addEventListener(
          `pointerup`,
          (e) => {
            if (!tap || tap.id !== e.pointerId) return;
            const dx = e.clientX - tap.x,
              dy = e.clientY - tap.y;
            const book = tap.book;
            tap = null;
            if (Math.hypot(dx, dy) > 10) return;
            popBook(book);
          },
          { passive: true },
        );
        track.addEventListener(
          `pointercancel`,
          () => {
            tap = null;
          },
          { passive: true },
        );
        track.addEventListener(`focusin`, (e) => {
          const book = e.target.closest(`.bookshelf__book`);
          if (book) setActiveNote(book.getAttribute(`data-book-index`));
        });
        track.addEventListener(`keydown`, (e) => {
          if (e.key !== `Enter` && e.key !== ` `) return;
          const book = e.target.closest(`.bookshelf__book`);
          if (!book) return;
          e.preventDefault();
          popBook(book);
        });
        if (window.matchMedia(`(hover: hover) and (pointer: fine)`).matches) {
          track.addEventListener(
            `pointerover`,
            (e) => {
              const book = e.target.closest(`.bookshelf__book`);
              if (book) setActiveNote(book.getAttribute(`data-book-index`));
            },
            { passive: true },
          );
        }
        const step = () => {
          const book = track.querySelector(`.bookshelf__book`);
          return book ? Math.round(book.getBoundingClientRect().width * 1.6) : 180;
        };
        const update = () => {
          const max = Math.max(0, track.scrollWidth - track.clientWidth);
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= max - 2;
          root.classList.toggle(`is-scrollable`, max > 4);
        };
        prev.addEventListener(`click`, () =>
          track.scrollBy({
            left: -step(),
            behavior: reduce() ? `auto` : `smooth`,
          }),
        );
        next.addEventListener(`click`, () =>
          track.scrollBy({
            left: step(),
            behavior: reduce() ? `auto` : `smooth`,
          }),
        );
        track.addEventListener(`scroll`, update, { passive: true });
        addEventListener(`resize`, update);
        update();
        setActiveNote(`0`);
      });
      bindBookshelf();
      document.addEventListener("astro:page-load", bindBookshelf);
    </script>
  </div>

  <script is:inline type="module">
    const bindReveals = () => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
        .matches;

      document.querySelectorAll("[data-reveal]").forEach((el) => {
        if (el.dataset.homeBound === "1") return;
        el.dataset.homeBound = "1";
        if (reduce) {
          el.classList.add("is-revealed");
          return;
        }
        el.classList.add("reveal-ready");
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-revealed");
              io.unobserve(entry.target);
            });
          },
          { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
        );
        io.observe(el);
      });
    };
    bindReveals();
    document.addEventListener("astro:page-load", bindReveals);
  </script>
</PageLayout>
